model Certificate {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user")
  user      User     @relation(fields: [userId], references: [id])
  category  String
  title     String
  courseId  Int      @map("course_id")
  size      Int      @default(4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}
