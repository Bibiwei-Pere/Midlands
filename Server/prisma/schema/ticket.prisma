model Tickets {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user")
  user        User     @relation(fields: [userId], references: [id])
  subject     String
  email       String
  description String
  category    String
  status      String   @default("Open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}