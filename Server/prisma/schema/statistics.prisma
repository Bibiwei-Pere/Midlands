model Statistics {
  id                 Int      @id @default(autoincrement())
  lastLogin          DateTime @default(now()) @map("last_login")
  isActive           Boolean  @default(false) @map("is_active")
  deletedUserCount   Int      @default(0) @map("deleted_user_count")
  userEnrolledToday  Int      @default(0) @map("user_enrolled_today")
  userStatsTotalUsers Int     @default(0) @map("user_stats_total_users")
  userStatsActiveUsers Int    @default(0) @map("user_stats_active_users")
  userStatsInactiveUsers Int  @default(0) @map("user_stats_inactive_users")
  userStatsCourseCompleted Int @default(0) @map("user_stats_course_completed")
  userStatsEnrollRate Float    @default(0) @map("user_stats_enroll_rate")
  userStatsChurnRate Float     @default(0) @map("user_stats_churn_rate")
  reviewStatsTotal   Int      @default(0) @map("review_stats_total")
  reviewStatsOne     Int      @default(0) @map("review_stats_one")
  reviewStatsTwo     Int      @default(0) @map("review_stats_two")
  reviewStatsThree   Int      @default(0) @map("review_stats_three")
  reviewStatsFour    Int      @default(0) @map("review_stats_four")
  reviewStatsFive    Int      @default(0) @map("review_stats_five")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
}